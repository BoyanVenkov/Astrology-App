# The app lives in resonance/ (Vite + Capacitor); it has its own .gitignore.
# docs/ is the GitHub Pages legal page. This root file just catches stray junk.

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Node / build output (defensive — normally under resonance/)
node_modules/
dist/
dist-ssr/
*.local

# Android / Gradle (defensive — the real project is resonance/android/)
.gradle/
.kotlin/
/build/
captures/
local.properties

# Secrets — never commit signing material or env files
*.jks
*.keystore
keystore.properties
.env
.env.local
.env.*.local

# Video-ad production (Resonance Ad/): renders, frames, stems and finished videos stay local —
# far too big for GitHub. The scripts, briefs and thumbnails are tracked.
Resonance Ad/**/work*/
Resonance Ad/**/stills*/
Resonance Ad/**/*.mp4
Resonance Ad/**/*.wav
Resonance Ad/**/*.mp3
